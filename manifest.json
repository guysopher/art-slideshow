{
  "manifest_version": 3,
  "name": "Art Slideshow",
  "version": "1.5",
  "description": "Full-screen slideshow of the Midjourney Explore page, with classical music.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Start Art Slideshow",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-music": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Music on/off"
    },
    "next-piece": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Next music piece"
    }
  },
  "permissions": [
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.midjourney.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-32.png"],
      "matches": ["https://www.midjourney.com/*"]
    }
  ]
}
