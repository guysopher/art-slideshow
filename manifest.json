{
  "manifest_version": 3,
  "name": "Art Slideshow",
  "version": "1.1",
  "description": "Full-screen slideshow of the Midjourney Explore page.",
  "action": { "default_title": "Start Art Slideshow" },
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://www.midjourney.com/*"]
}
