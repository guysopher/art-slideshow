{
  "manifest_version": 3,
  "name": "Art Slideshow",
  "version": "1.2",
  "description": "Full-screen slideshow of the Midjourney Explore page, with classical music.",
  "action": {
    "default_title": "Start Art Slideshow"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.midjourney.com/*"
  ]
}
